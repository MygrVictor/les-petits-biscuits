# Base de données (Neon / Vercel Postgres)
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Admin — côté serveur uniquement, PAS de préfixe VITE_
ADMIN_USER=admin
ADMIN_PASSWORD=change-moi
# openssl rand -base64 48
ADMIN_SECRET=

# SumUp
SUMUP_API_KEY=sup_sk_xxx
SUMUP_MERCHANT_CODE=MXXXXXXX
# Clé PUBLIQUE (Apple Pay / Google Pay) — sup_pk_…, sans danger côté navigateur
VITE_SUMUP_PUBLIC_KEY=sup_pk_xxx
